#include <iostream>
#include <string>
using namespace std;

struct Employee {
    int id;
    string name;
    float salary;
};

void displayAll(Employee employees[], int n) {
    cout << "\n--- Employee Details ---\n";
    for (int i = 0; i < n; i++) {
        cout << "ID: " << employees[i].id << endl;
        cout << "Name: " << employees[i].name << endl;
        cout << "Salary: ₹" << employees[i].salary << endl;
        cout << "-------------------------\n";
    }
}

void searchById(Employee employees[], int n, int searchId) {
    bool found = false;
    for (int i = 0; i < n; i++) {
        if (employees[i].id == searchId) {
            cout << "\nEmployee Found:\n";
            cout << "ID: " << employees[i].id << endl;
            cout << "Name: " << employees[i].name << endl;
            cout << "Salary: ₹" << employees[i].salary << endl;
            found = true;
            break;
        }
    }
    if (!found) {
        cout << "\nEmployee with ID " << searchId << " not found.\n";
    }
}

void increaseSalary(Employee employees[], int n) {
    for (int i = 0; i < n; i++) {
        if (employees[i].salary < 30000) {
            employees[i].salary *= 1.10;  // Increase by 10%
        }
    }
    cout << "\nSalary increased by 10% for employees earning less than ₹30,000.\n";
}

int main() {
    const int n = 10;
    Employee employees[n];

    // Input employee details
    cout << "Enter details for 10 employees:\n";
    for (int i = 0; i < n; i++) {
        cout << "\nEmployee " << (i + 1) << ":\n";
        cout << "ID: ";
        cin >> employees[i].id;
        cout << "Name: ";
        cin.ignore();  // To ignore leftover newline character before getline
        getline(cin, employees[i].name);
        cout << "Salary: ₹";
        cin >> employees[i].salary;
    }

    int choice;
    do {
        cout << "\nMenu:\n";
        cout << "1. Display all employee details\n";
        cout << "2. Search employee by ID\n";
        cout << "3. Increase salary of employees earning less than ₹30,000 by 10%\n";
        cout << "4. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                displayAll(employees, n);
                break;

            case 2: {
                int searchId;
                cout << "Enter employee ID to search: ";
                cin >> searchId;
                searchById(employees, n, searchId);
                break;
            }

            case 3:
                increaseSalary(employees, n);
                break;

            case 4:
                cout << "Exiting program. Goodbye!\n";
                break;

            default:
                cout << "Invalid choice. Please try again.\n";
        }
    } while (choice != 4);

    return 0;
}
